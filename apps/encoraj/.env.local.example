# MongoDB Atlas — a URI precisa incluir o nome do banco
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/encoraj?retryWrites=true&w=majority

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# URL pública do app (vai dentro do QR code)
APP_URL=http://localhost:3000

# Email (SMTP — Nodemailer) — recuperação de senha
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Google Gemini (OCR)
GEMINI_API_KEY=
# Opcional: troca o modelo sem mexer no código (padrão: gemini-3.6-flash; mais barato: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Custo estimado de IA em /admin/ai: preço em dólar por 1 milhão de tokens (tabela do provedor)
AI_PRICE_INPUT_USD_PER_MTOK=
AI_PRICE_OUTPUT_USD_PER_MTOK=


# Identificação nos Termos de Uso e na Política de Privacidade (/termos, /privacidade)
LEGAL_COMPANY_NAME=
# CNPJ ou CPF de quem opera o serviço (opcional)
LEGAL_COMPANY_DOC=
# Canal para dúvidas e pedidos sobre dados pessoais (encarregado/DPO)
LEGAL_CONTACT_EMAIL=
